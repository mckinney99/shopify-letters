{
  "name": "shopify-letters",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "node scripts/check-env.mjs && node scripts/dev.mjs",
    "dev:vite": "vite",
    "dev:shopify": "shopify app dev",
    "setup": "prisma generate && prisma migrate dev",
    "config:link": "shopify app config link",
    "deploy": "shopify app deploy",
    "check-env": "node scripts/check-env.mjs",
    "start": "node scripts/check-env.mjs && prisma migrate deploy && remix-serve ./build/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "verify": "npm run typecheck && npm run test:unit",
    "prepare": "husky"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@remix-run/node": "^2.13.1",
    "@remix-run/react": "^2.13.1",
    "@remix-run/serve": "^2.13.1",
    "@shopify/app-bridge-react": "^4.2.11",
    "@shopify/polaris": "^13.9.5",
    "@shopify/shopify-api": "^13.0.0",
    "@shopify/shopify-app-remix": "^4.2.0",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "isbot": "^4.4.0",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.13.1",
    "@shopify/cli": "^3.66.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "husky": "^9.1.7",
    "npm-run-all2": "^8.0.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.6",
    "vitest": "^2.1.3"
  },
  "workspaces": [
    "extensions/*"
  ],
  "engines": {
    "node": ">=18.20.0"
  }
}
