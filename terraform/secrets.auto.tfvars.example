# Copy this file to secrets.auto.tfvars (gitignored, picked up automatically
# by terraform plan/apply) and fill in a real token.
#
# Create a Cloudflare API token at https://dash.cloudflare.com/profile/api-tokens
# using the "Edit zone DNS" template, scoped to the etch.direct zone only.

cloudflare_api_token = "your-cloudflare-api-token-here"
