# Copy this file to secrets.auto.tfvars (gitignored, picked up automatically
# by terraform plan/apply) and fill in real values.
#
# Create a Cloudflare API token at https://dash.cloudflare.com/profile/api-tokens
# using the "Edit zone DNS" template, scoped to the etch.direct zone only.

cloudflare_api_token = "your-cloudflare-api-token-here"

# Shopify app credentials — same values as SHOPIFY_API_KEY / SHOPIFY_API_SECRET
# in your local .env (from partners.shopify.com -> Apps -> Etch -> API credentials).
# Stored in AWS Secrets Manager and injected into the ECS task at runtime.
shopify_api_key    = "your-shopify-api-key-here"
shopify_api_secret = "your-shopify-api-secret-here"
