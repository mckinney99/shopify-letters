# Shopify app credentials — get these from your Shopify Partners dashboard
# https://partners.shopify.com → Apps → your app → API credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Comma-separated list of API scopes your app requests
SCOPES=read_products,write_products,read_orders,write_orders

# Set automatically by `shopify app dev` during local development
SHOPIFY_APP_URL=

# Postgres connection string. For local dev, start the database with
# `docker compose up -d` (see docker-compose.yml) and use the URL below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/shopify_letters?schema=public"

# Optional: restrict app to a custom shop domain
# SHOP_CUSTOM_DOMAIN=

# Optional: deployed theme app extension UUID (Partner Dashboard → your app →
# Extensions → Etch Customization, or from `shopify app deploy`). When set, the
# in-app onboarding "Add the Etch widget" button deep-links straight into the
# theme editor with the app block pre-added. When unset, the button still opens
# the theme editor and merchants add the block manually. See SL-70.
# SHOPIFY_THEME_APP_EXTENSION_UUID=
