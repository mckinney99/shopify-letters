# Shopify app credentials — get these from your Shopify Partners dashboard
# https://partners.shopify.com → Apps → your app → API credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Comma-separated list of API scopes your app requests
SCOPES=read_products,write_products,read_orders,write_orders

# Set automatically by `shopify app dev` during local development
SHOPIFY_APP_URL=

# Postgres connection string. For local dev, start the database with
# `docker compose up -d` (see docker-compose.yml) and use the URL below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopify_letters?schema=public"

# Optional: restrict app to a custom shop domain
# SHOP_CUSTOM_DOMAIN=
