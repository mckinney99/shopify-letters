{%- liquid
  assign numeric_product_id = product.id
  assign shop_domain = shop.permanent_domain
-%}

<div
  id="etch-customization-{{ block.id }}"
  class="etch-customization"
  data-shop="{{ shop_domain | escape }}"
  data-product-id="{{ numeric_product_id }}"
  data-app-url="{{ block.settings.app_url | escape }}"
  data-heading="{{ block.settings.heading | escape }}"
  {{ block.shopify_attributes }}
>
  <p class="etch-customization__loading" aria-live="polite">
    Loading customization options&hellip;
  </p>
  <div class="etch-customization__fields" hidden></div>
  <p class="etch-customization__error" role="alert" hidden></p>
  <p class="etch-customization__price" aria-live="polite" hidden></p>
</div>

{{ 'etch-customization.css' | asset_url | stylesheet_tag }}
<script src="{{ 'etch-customization.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Etch Customization",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Personalize your item"
    },
    {
      "type": "text",
      "id": "app_url",
      "label": "App URL",
      "default": "https://etch.direct",
      "info": "The URL of your Etch app. Do not change unless instructed."
    }
  ]
}
{% endschema %}
