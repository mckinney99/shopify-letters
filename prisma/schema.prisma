// Learn more about this file: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite for local development; swap to postgresql for production
  // DATABASE_URL in .env controls which is used
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Required by @shopify/shopify-app-session-storage-prisma
model Session {
  id          String    @id
  shop        String
  state       String
  isOnline    Boolean   @default(false)
  scope       String?
  expires     DateTime?
  accessToken String
  userId      BigInt?
  firstName   String?
  lastName    String?
  email       String?
  accountOwner Boolean  @default(false)
  locale      String?
  collaborator Boolean? @default(false)
  emailVerified Boolean? @default(false)
}

model ProductConfig {
  id        String   @id @default(cuid())
  shop      String
  productId String
  enabled   Boolean  @default(false)
  published Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([shop, productId])
}

model CustomizationField {
  id              String   @id @default(cuid())
  shop            String
  productId       String
  label           String
  type            String   @default("text")
  minChars        Int?
  maxChars        Int?
  allowedChars    String?
  disallowedChars String?
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shop, productId])
}

// fieldId = "" means product-level base price; fieldId = <CustomizationField.id> means per-field pricing
model PricingRule {
  id           String         @id @default(cuid())
  shop         String
  productId    String
  fieldId      String
  basePrice    Float          @default(0)
  perCharPrice Float          @default(0)
  charGroups   CharPriceGroup[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([shop, productId, fieldId])
  @@index([shop, productId])
}

model CharPriceGroup {
  id            String      @id @default(cuid())
  pricingRuleId String
  label         String
  characters    String
  pricePerChar  Float       @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  rule          PricingRule @relation(fields: [pricingRuleId], references: [id], onDelete: Cascade)
}
